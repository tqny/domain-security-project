# Brand Protection Control Center — Environment Variables
# Copy to .env and fill in values as needed.

# shadcnblocks (used during Phase E dashboard import — not needed at runtime)
SHADCNBLOCKS_API_KEY=

# Threat intelligence enrichment for Live Scan (optional)
# Without these keys, Live Scan still works — URLhaus and OTX enrichment are skipped gracefully.

# URLhaus (abuse.ch) — free API key for malicious URL database
# Sign up: https://auth.abuse.ch/
VITE_URLHAUS_AUTH_KEY=

# AlienVault OTX — free API key for community threat intelligence
# Sign up: https://otx.alienvault.com/ (API key in Settings)
VITE_OTX_API_KEY=

# Spamhaus DBL — free DQS key for domain blocklist (phishing, malware, spam, botnet C&C)
# Sign up: https://portal.spamhaus.com/auth/account-setup?ps=free_dqs_product
VITE_SPAMHAUS_DQS_KEY=
